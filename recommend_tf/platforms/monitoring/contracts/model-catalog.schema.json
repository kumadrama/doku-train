  "type": "object",
  "required": [
    "schema_version",
    "environment",
    "model_name"
  ],
  "properties": {
    "schema_version": {
      "const": "doku-model-catalog/v1"
    },
    "tasks": {
      "type": "array"
    },
    "online": {
      "type": "object"
    },
