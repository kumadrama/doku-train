{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "required": [
    "schema_version",
    "environment",
    "model_name"
  ],
  "properties": {
    "schema_version": {
      "const": "doku-model-catalog/v1"
    },
    "tasks": {
      "type": "array"
    },
    "online": {
      "type": "object"
    },
    "release": {
      "type": "object"
    },
    "previous_recipe": {
      "type": "object",
      "required": [
        "recipe_sha256",
        "last_data_cutoff"
      ],
      "properties": {
        "recipe_sha256": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        },
        "last_data_cutoff": {
          "type": "string",
          "format": "date"
        }
      }
    }
  }
}
