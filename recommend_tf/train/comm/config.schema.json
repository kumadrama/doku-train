{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "TF training envelope identity extension",
  "description": "model_name is an optional top-level metadata field for offline runs and required by daily_train_model. Model-specific schemas describe the nested model object.",
  "type": "object",
  "properties": {
    "model_name": {
      "type": "string",
      "pattern": "^[a-z][a-z0-9_]{0,63}$"
    },
    "data_sources": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": [
          "name",
          "source_id",
          "format"
        ],
        "properties": {
          "name": {
            "type": "string"
          },
          "source_id": {
            "type": "integer",
            "minimum": 0
          },
          "format": {
            "const": "doku-train-dataset-manifest/v1"
          },
          "manifest_uri": {
            "type": "string",
            "minLength": 1
          },
          "manifest_uris": {
            "type": "array",
            "minItems": 1,
            "uniqueItems": true,
            "items": {
              "type": "string",
              "minLength": 1
            }
          }
        },
        "additionalProperties": false,
        "oneOf": [
          {
            "required": [
              "manifest_uri"
            ]
          },
          {
            "required": [
              "manifest_uris"
            ]
          }
        ]
      }
    },
    "export_tasks": {
      "description": "Names from model.tasks to expose in the inference signature. Existing recipes may select outputs through the deployment binding.",
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {
        "type": "string",
        "minLength": 1
      }
    }
  }
}
